{
  "name": "gitvantage",
  "displayName": "GitVantage",
  "publisher": "sswarekar-git",
  "description": "Fast, keyboard-friendly Git tooling for VS Code",
  "version": "0.0.4",
  "license": "GPL-3.0-or-later",
  "icon": "media/icons/icon.png",
  "files": [
    "out/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sswarekar-git/GitVantage.git"
  },
  "bugs": {
    "url": "https://github.com/sswarekar-git/GitVantage/issues"
  },
  "homepage": "https://github.com/sswarekar-git/GitVantage#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitvantage",
          "title": "GitVantage",
          "icon": "media/icons/gitvantage-activitybar.svg"
        }
      ],
      "panel": [
        {
          "id": "gitvantageLogPanel",
          "title": "Git Log",
          "icon": "media/icons/gitvantage-activitybar.svg"
        }
      ]
    },
    "views": {
      "gitvantage": [
        {
          "id": "gitvantage.commit",
          "name": "Commit",
          "type": "webview"
        },
        {
          "id": "gitvantage.stash",
          "name": "Stash",
          "type": "webview"
        }
      ],
      "gitvantageLogPanel": [
        {
          "id": "gitvantage.log",
          "name": "Log",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitvantage.refreshAll",
        "title": "GitVantage: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitvantage.openLog",
        "title": "GitVantage: Open Git Log",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitvantage.showBranchesPopup",
        "title": "GitVantage: Branches..."
      },
      {
        "command": "gitvantage.fetch",
        "title": "GitVantage: Fetch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitvantage.pull",
        "title": "GitVantage: Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitvantage.push",
        "title": "GitVantage: Push",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitvantage.pruneRemotes",
        "title": "GitVantage: Prune Remote-Tracking Branches"
      },
      {
        "command": "gitvantage.addRemote",
        "title": "GitVantage: Add Remote..."
      },
      {
        "command": "gitvantage.switchRepository",
        "title": "GitVantage: Switch Repository"
      },
      {
        "command": "gitvantage.toggleBlame",
        "title": "GitVantage: Toggle Blame Annotations"
      },
      {
        "command": "gitvantage.localHistory.show",
        "title": "GitVantage: Show Local History"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitvantage.pull",
          "when": "view == gitvantage.commit",
          "group": "navigation@1"
        },
        {
          "command": "gitvantage.push",
          "when": "view == gitvantage.commit",
          "group": "navigation@2"
        },
        {
          "command": "gitvantage.fetch",
          "when": "view == gitvantage.commit",
          "group": "navigation@3"
        },
        {
          "command": "gitvantage.refreshAll",
          "when": "view == gitvantage.commit",
          "group": "navigation@4"
        },
        {
          "command": "gitvantage.addRemote",
          "when": "view == gitvantage.commit",
          "group": "1_modification"
        },
        {
          "command": "gitvantage.pull",
          "when": "view == gitvantage.log",
          "group": "navigation@1"
        },
        {
          "command": "gitvantage.push",
          "when": "view == gitvantage.log",
          "group": "navigation@2"
        },
        {
          "command": "gitvantage.fetch",
          "when": "view == gitvantage.log",
          "group": "navigation@3"
        },
        {
          "command": "gitvantage.refreshAll",
          "when": "view == gitvantage.log",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "gitvantage.toggleBlame",
          "when": "editorTextFocus",
          "group": "gitvantage@1"
        },
        {
          "command": "gitvantage.localHistory.show",
          "when": "editorTextFocus",
          "group": "gitvantage@2"
        }
      ]
    },
    "configuration": {
      "title": "GitVantage",
      "properties": {
        "gitvantage.log.pageSize": {
          "type": "number",
          "default": 200
        },
        "gitvantage.commit.subjectLineLimit": {
          "type": "number",
          "default": 72
        }
      }
    }
  },
  "scripts": {
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "vscode:prepublish": "node esbuild.js",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview-ui && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "preact": "^10.22.0"
  }
}